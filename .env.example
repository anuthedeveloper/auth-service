# Copy to .env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# Local development defaults (matches docker-compose.yml)
DATABASE_URL=postgresql://auth:auth@localhost:5432/auth_service
REDIS_URL=redis://localhost:6379

# Required. Generate with: openssl rand -base64 48
# (the placeholder below is intentionally too short, so the app refuses to start until you replace it)
JWT_ACCESS_SECRET=replace-me
JWT_ISSUER=auth-service
# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Absolute refresh-session lifetime in days; the user must log in again after this
REFRESH_TOKEN_TTL_DAYS=7

# Only used by `npm run db:seed:admin` to create the first admin. Leave unset otherwise.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-long-unique-passphrase

# --- Email (verification and password reset) ---
# Base URL of the frontend that handles /verify-email and /reset-password links
APP_BASE_URL=http://localhost:3000
# true = unverified accounts cannot sign in (403 EMAIL_NOT_VERIFIED)
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_FROM=Auth Service <no-reply@localhost>
# console = print emails to the log (development only; refused in production)
# smtp    = send through the SMTP server below (required in production)
EMAIL_TRANSPORT=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Abuse protection ---
# Redis-backed rate limits on every route (per-IP, plus per-address on the email endpoints)
RATE_LIMIT_ENABLED=true
# redis = shared across instances (production); memory = per process only
RATE_LIMIT_STORE=redis
# Number of reverse proxies in front of the app (0 = none). Use the exact count: too high lets
# clients spoof X-Forwarded-For. Behind Azure App Service this is usually 1.
TRUST_PROXY=0
# Account lockout: wrong passwords before the account locks, and for how long
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- API documentation ---
# Swagger UI at /docs and the raw spec at /openapi.json.
# Unset = on everywhere except production. Set to true to publish the docs from a production deployment.
# API_DOCS_ENABLED=true
